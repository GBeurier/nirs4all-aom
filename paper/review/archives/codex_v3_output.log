+AOMRIDGE_PARTIAL = ROOT / "bench/AOM_v0/Ridge/benchmark_runs/paper_aom_aomridge_seeds012/results.csv"
+AOMRIDGE_HEADLINE = ROOT / "bench/AOM_v0/Ridge/benchmark_runs/all54_headline/results.csv"
