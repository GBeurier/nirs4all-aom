+def write_time_table(dfs: dict[str, pd.DataFrame]) -> None:
+    fast_summary = pd.read_csv(FAST_SUMMARY)
+    rows = []
+
+    def add_from_df(label: str, df: pd.DataFrame, variant: str, evals: str) -> None:
+        sub = df[df["variant"].astype("string").str.lower() == variant.lower()]
+        total = sub["total_time_s"].dropna()
+        fit = sub["fit_time_s"].dropna()
+        rows.append(
+            {
+                "label": label,
+                "datasets": sub["dataset"].nunique(),
+                "runs": len(sub),
+                "evals": evals,
+                "median_fit": float(fit.median()) if not fit.empty else float("nan"),
+                "median_total": float(total.median()) if not total.empty else float("nan"),
+                "total_h": float(total.sum() / 3600.0) if not total.empty else float("nan"),
+            }
+        )
+
+    add_from_df("PLS-default-cv5", dfs["default"], "pls-default-cv5", "25 CV fits")
+    add_from_df("Ridge-default-cv5", dfs["default"], "ridge-default-cv5", "15 CV fits")
+    add_from_df("PLS-TabPFN-HPO", dfs["pls_hpo"], "pls-tabpfn-hpo-25trials", "600 x 5 trials")
+    add_from_df("Ridge-TabPFN-HPO", dfs["ridge_hpo"], "ridge-tabpfn-hpo-60trials", "600 x 10 trials")
+    add_from_df("AOM-compact-cv5", dfs["aompls"], "AOM-compact-cv5-numpy", "9 ops x CV5")
+    add_from_df("ASLS-AOM-compact-cv5", dfs["aompls"], "ASLS-AOM-compact-cv5-numpy", "ASLS branch + 9 ops x CV5")
+    add_from_df("AOMRidge-Blender", dfs["ridge_head"], "AOMRidge-Blender-headline-spxy3", "nested selector")
+
+    for model in [
+        "FastAOM-sparse-mkr-supervised",
+        "FastAOM-sparse-mkr-compact",
+        "FastAOM-single-chain-compact",
+        "FastAOMPLSRidge orchestrator",
+    ]:
+        if model == "FastAOMPLSRidge orchestrator":
+            rows.append(
+                {
+                    "label": model,
+                    "datasets": int(fast_summary[fast_summary["model"].str.startswith("FastAOM")]["n_datasets"].max()),
+                    "runs": 0,
+                    "evals": "bases, chains, SVD, screen, fit",
+                    "median_fit": float("nan"),
+                    "median_total": float("nan"),
+                    "total_h": float("nan"),
+                }
+            )
+            continue
+        r = fast_summary[fast_summary["model"] == model].iloc[0]
+        rows.append(
+            {
+                "label": model,
+                "datasets": int(r["n_datasets"]),
+                "runs": int(r["n_datasets"]),
+                "evals": "screened chain/kernel space",
+                "median_fit": float(r["median_fit_time"]),
+                "median_total": float(r["median_fit_time"]),
+                "total_h": float("nan"),
+            }
+        )
+
+    lines = [
+        r"\begin{tabularx}{\linewidth}{p{0.30\linewidth}rXrr}",
+        r"\toprule",
+        r"Method & Datasets & Search budget & Median fit (s) & Median total (s) \\",
+        r"\midrule",
+    ]
+    for r in rows:
+        budget = r["evals"]
+        if np.isfinite(r["total_h"]):
+            budget = f"{budget}; observed {r['total_h']:.1f} h"
+        lines.append(
+            f"{latex_escape(r['label'])} & {r['datasets']} & {latex_escape(budget)} & "
+            f"{fmt_float(r['median_fit'], 2)} & {fmt_float(r['median_total'], 2)} \\\\"
+        )
+    lines += [r"\bottomrule", r"\end{tabularx}", ""]
+    (TABLES / "table_time_budget.tex").write_text("\n".join(lines))
+
