+            f"{100.0 * float(r['fraction_of_components']):.1f}\\% & "
+            f"{int(r['n_datasets_using_it'])} \\\\"
+        )
+    lines += [r"\bottomrule", r"\end{tabularx}", ""]
+    (TABLES / "table_selector_diagnostics.tex").write_text("\n".join(lines))
+
+
