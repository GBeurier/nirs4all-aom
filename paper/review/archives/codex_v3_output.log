+                "FastAOM full60 seed0 wide table",
+            ),
+            stat_row(
+                "FastAOM-sparse-mkr-compact vs PLS-standard",
+                "FastAOM-sparse-mkr-compact",
+                "PLS-standard-numpy",
+                per_dataset_wide(wide, "FastAOM-sparse-mkr-compact"),
