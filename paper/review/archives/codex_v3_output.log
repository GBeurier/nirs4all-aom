+def build_runtime_distribution(dfs: dict[str, pd.DataFrame]) -> None:
+    series = []
+    labels = []
+    specs = [
+        ("PLS-HPO total", dfs["pls_hpo"], "pls-tabpfn-hpo-25trials", "total_time_s"),
+        ("Ridge-HPO total", dfs["ridge_hpo"], "ridge-tabpfn-hpo-60trials", "total_time_s"),
+        ("ASLS-AOM fit", dfs["aompls"], "ASLS-AOM-compact-cv5-numpy", "fit_time_s"),
+        ("AOM-compact fit", dfs["aompls"], "AOM-compact-cv5-numpy", "fit_time_s"),
+        ("AOMRidge-Blender fit", dfs["ridge_head"], "AOMRidge-Blender-headline-spxy3", "fit_time_s"),
+    ]
+    fast = ok_rows(pd.read_csv(FAST_LONG, low_memory=False))
+    fast["variant"] = fast["result_label"]
+    fast["fit_time_s"] = pd.to_numeric(fast["fit_time_s"], errors="coerce")
+    for label, df, variant, col in specs:
+        vals = df[df["variant"].astype("string").str.lower() == variant.lower()][col].dropna().to_numpy()
+        if vals.size:
+            labels.append(label)
+            series.append(vals)
+    for variant in ["FastAOM-sparse-mkr-supervised", "FastAOM-sparse-mkr-compact", "FastAOM-single-chain-compact"]:
+        vals = fast[fast["variant"] == variant]["fit_time_s"].dropna().to_numpy()
+        if vals.size:
+            labels.append(variant)
+            series.append(vals)
+    fig, ax = plt.subplots(figsize=(6.8, max(3.0, 0.35 * len(labels))))
+    bp = ax.boxplot(series, vert=False, labels=labels, patch_artist=True, showfliers=False)
+    for patch in bp["boxes"]:
+        patch.set_facecolor("#8AB6D6")
+        patch.set_alpha(0.8)
+    ax.set_xscale("log")
+    ax.set_xlabel("Seconds (log scale)")
+    ax.set_title("Runtime distribution across observed runs")
+    ax.grid(True, axis="x", linestyle=":", linewidth=0.4, alpha=0.6)
+    save_fig(fig, "fig_runtime_distribution")
+
