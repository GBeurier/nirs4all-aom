            boxstyle="round,pad=0.004,rounding_size=0.022",
            facecolor=col["face"],
            edgecolor="none",
            zorder=-5,
            clip_on=False,
        )
        ax.add_patch(bg)
        # Accent ribbon under the title.
        ax.add_patch(
            Rectangle(
                (col["x"] + 0.016, 0.866),
                col["w"] - 0.032,
                0.012,
                facecolor=col["bar"],
                edgecolor="none",
                zorder=-3,
            )
        )
        ax.text(
            col["x"] + col["w"] / 2,
            0.905,
            col["title"],
            ha="center",
            va="bottom",
            weight="bold",
            color=INK,
            fontsize=9.4,

