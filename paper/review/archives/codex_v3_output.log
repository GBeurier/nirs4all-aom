+        r"\caption{Per-dataset regression results for the FastAOM headline table and reference variants.  Relative RMSEP is divided by PLS-standard on the same dataset; QUARTZ-style near-zero denominators are left as n/a.}\\",
+        r"\toprule",
+        r"Dataset & Variant & RMSEP & Rel. RMSEP \\",
+        r"\midrule",
+        r"\endfirsthead",
+        r"\toprule",
+        r"Dataset & Variant & RMSEP & Rel. RMSEP \\",
+        r"\midrule",
+        r"\endhead",
+    ]
+    for dataset, variant, rmsep, rel in rows:
+        lines.append(
+            f"{latex_escape(dataset)} & {latex_escape(variant)} & {rmsep:.4g} & {fmt_float(rel)} \\\\"
+        )
+    lines += [r"\bottomrule", r"\end{longtable}", ""]
+    (TABLES / "table_supplement_long_results.tex").write_text("\n".join(lines))
