+            max_rmsep=("rmsep", "max"),
+            ratio_meaningful=("ratio_meaningful", "first"),
+        )
+        .reset_index()
+        .sort_values(["ratio_meaningful", "dataset"], ascending=[True, True])
+        .head(18)
