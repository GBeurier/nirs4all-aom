+    return rows, {
+        "aompls": aompls,
+        "default": default,
+        "pls_hpo": pls_hpo,
+        "ridge_hpo": ridge_hpo,
+        "ridge_head": ridge_head,
+        "ridge_partial": ridge_partial,
+        "wide": wide,
+    }
