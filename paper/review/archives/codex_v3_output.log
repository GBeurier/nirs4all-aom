+            f"{latex_escape(r['dataset'])} & {int(r['variants'])} & {int(r['finite_rmsep'])} & "
+            f"{fmt_float(r['min_rmsep'], 4)} & {fmt_float(r['max_rmsep'], 4)} \\\\"
+        )
+    lines += [r"\bottomrule", r"\end{tabularx}", ""]
+    (TABLES / "table_failure_modes.tex").write_text("\n".join(lines))
+
