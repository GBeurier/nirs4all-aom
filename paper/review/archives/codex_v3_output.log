+            stat_row(
+                "FastAOM-single-chain-compact vs PLS-TabPFN-HPO",
+                "FastAOM-single-chain-compact",
+                "pls-tabpfn-hpo-25trials",
+                per_dataset_wide(wide, "FastAOM-single-chain-compact"),
+                per_dataset(pls_hpo, "pls-tabpfn-hpo-25trials"),
