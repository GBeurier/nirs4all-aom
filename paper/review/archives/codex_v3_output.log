+        r"\midrule",
+        r"\endfirsthead",
+        r"\toprule",
+        r"Dataset & Variant & RMSEP & Rel. RMSEP \\",
+        r"\midrule",
+        r"\endhead",
+    ]
+    for dataset, variant, rmsep, rel in rows:
+        lines.append(
+            f"{latex_escape(dataset)} & {latex_escape(variant)} & {rmsep:.4g} & {fmt_float(rel)} \\\\"
+        )
