+CLS_AOMPLS = ROOT / "bench/AOM_v0/benchmark_runs/paper_aom_aompls_da_seeds012/results.csv"
+CLS_AOMRIDGE = ROOT / "bench/AOM_v0/Ridge/benchmark_runs/paper_aom_aomridge_cls_seeds012/results.csv"
