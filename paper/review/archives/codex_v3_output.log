+def save_fig(fig: plt.Figure, stem: str, png: bool = True) -> None:
+    FIGURES.mkdir(parents=True, exist_ok=True)
+    fig.savefig(FIGURES / f"{stem}.pdf", bbox_inches="tight")
+    if png:
+        fig.savefig(FIGURES / f"{stem}.png", dpi=300, bbox_inches="tight")
+    plt.close(fig)
+
+
+def build_figures(rows: list[dict], dfs: dict[str, pd.DataFrame]) -> None:
+    plt.rcParams.update(
+        {
+            "font.size": 8,
+            "axes.spines.top": False,
+            "axes.spines.right": False,
+            "pdf.fonttype": 42,
+            "ps.fonttype": 42,
+        }
+    )
+    build_accuracy_time(rows, dfs)
+    build_runtime_distribution(dfs)
+    build_results_overview(rows)
+    build_budget_figure()
+    build_operator_heatmap()
+    build_dataset_variant_heatmap(dfs)
+    build_fastaom_variants_figure()
+
+
+def build_accuracy_time(rows: list[dict], dfs: dict[str, pd.DataFrame]) -> None:
+    by_label = {r["label"]: r for r in rows}
+    time_lookup = {}
+    for label, df, variant in [
+        ("PLS-default", dfs["default"], "pls-default-cv5"),
+        ("PLS-HPO", dfs["pls_hpo"], "pls-tabpfn-hpo-25trials"),
+        ("ASLS-AOM", dfs["aompls"], "ASLS-AOM-compact-cv5-numpy"),
+        ("AOM-compact", dfs["aompls"], "AOM-compact-cv5-numpy"),
+        ("Ridge-default", dfs["default"], "ridge-default-cv5"),
+        ("Ridge-HPO", dfs["ridge_hpo"], "ridge-tabpfn-hpo-60trials"),
+        ("AOMRidge-Blender", dfs["ridge_head"], "AOMRidge-Blender-headline-spxy3"),
+    ]:
+        sub = df[df["variant"].astype("string").str.lower() == variant.lower()]
+        col = "total_time_s" if "HPO" in label or "default" in label.lower() else "fit_time_s"
+        time_lookup[label] = float(sub[col].dropna().median()) if not sub.empty else float("nan")
+    fs = pd.read_csv(FAST_SUMMARY)
+    for model in ["FastAOM-sparse-mkr-supervised", "FastAOM-sparse-mkr-compact", "FastAOM-single-chain-compact"]:
+        time_lookup[model] = float(fs.loc[fs["model"] == model, "median_fit_time"].iloc[0])
+
+    points = [
+        ("PLS-default", 1.0, "PLS"),
+        ("PLS-HPO", by_label["PLS-TabPFN-HPO vs PLS-default"]["stats"]["median"], "PLS"),
+        ("ASLS-AOM", by_label["ASLS-AOM-compact-cv5 vs PLS-default"]["stats"]["median"], "AOM-PLS"),
+        ("AOM-compact", by_label["AOM-compact-cv5 vs PLS-default"]["stats"]["median"], "AOM-PLS"),
+        ("Ridge-default", 1.0, "Ridge"),
+        ("Ridge-HPO", by_label["Ridge-TabPFN-HPO vs Ridge-default"]["stats"]["median"], "Ridge"),
+        ("AOMRidge-Blender", by_label["AOMRidge-Blender vs Ridge-default"]["stats"]["median"], "AOM-Ridge"),
+        ("FastAOM-sparse-mkr-supervised", by_label["FastAOM-sparse-mkr-supervised vs PLS-standard"]["stats"]["median"], "FastAOM"),
+        ("FastAOM-sparse-mkr-compact", by_label["FastAOM-sparse-mkr-compact vs PLS-standard"]["stats"]["median"], "FastAOM"),
+        ("FastAOM-single-chain-compact", by_label["FastAOM-single-chain-compact vs PLS-standard"]["stats"]["median"], "FastAOM"),
+    ]
+    colors = {"PLS": "#4C78A8", "Ridge": "#59A14F", "AOM-PLS": "#F28E2B", "AOM-Ridge": "#8CD17D", "FastAOM": "#B07AA1"}
+    fig, ax = plt.subplots(figsize=(6.8, 4.0))
+    for label, ratio, family in points:
+        x = time_lookup.get(label, float("nan"))
+        if not (np.isfinite(x) and np.isfinite(ratio)):
+            continue
+        ax.scatter(x, ratio, s=52, color=colors[family], edgecolor="black", linewidth=0.4, label=family)
+        ax.annotate(label, (x, ratio), xytext=(4, 3), textcoords="offset points", fontsize=6.8)
+    handles, labels = ax.get_legend_handles_labels()
+    dedup = dict(zip(labels, handles))
+    ax.legend(dedup.values(), dedup.keys(), loc="best")
+    ax.axhline(1.0, color="#555555", linewidth=0.8, linestyle="--")
+    ax.set_xscale("log")
+    ax.set_xlabel("Median search or fit time (s, log scale)")
+    ax.set_ylabel("Median RMSEP ratio vs family reference")
+    ax.set_title("Accuracy/time Pareto")
+    ax.grid(True, axis="both", linestyle=":", linewidth=0.4, alpha=0.6)
+    save_fig(fig, "fig_accuracy_time_pareto")
+
+
+def build_runtime_distribution(dfs: dict[str, pd.DataFrame]) -> None:
+    series = []
+    labels = []
+    specs = [
+        ("PLS-HPO total", dfs["pls_hpo"], "pls-tabpfn-hpo-25trials", "total_time_s"),
+        ("Ridge-HPO total", dfs["ridge_hpo"], "ridge-tabpfn-hpo-60trials", "total_time_s"),
+        ("ASLS-AOM fit", dfs["aompls"], "ASLS-AOM-compact-cv5-numpy", "fit_time_s"),
+        ("AOM-compact fit", dfs["aompls"], "AOM-compact-cv5-numpy", "fit_time_s"),
+        ("AOMRidge-Blender fit", dfs["ridge_head"], "AOMRidge-Blender-headline-spxy3", "fit_time_s"),
+    ]
+    fast = ok_rows(pd.read_csv(FAST_LONG, low_memory=False))
+    fast["variant"] = fast["result_label"]
+    fast["fit_time_s"] = pd.to_numeric(fast["fit_time_s"], errors="coerce")
+    for label, df, variant, col in specs:
+        vals = df[df["variant"].astype("string").str.lower() == variant.lower()][col].dropna().to_numpy()
+        if vals.size:
+            labels.append(label)
+            series.append(vals)
+    for variant in ["FastAOM-sparse-mkr-supervised", "FastAOM-sparse-mkr-compact", "FastAOM-single-chain-compact"]:
+        vals = fast[fast["variant"] == variant]["fit_time_s"].dropna().to_numpy()
+        if vals.size:
+            labels.append(variant)
+            series.append(vals)
+    fig, ax = plt.subplots(figsize=(6.8, max(3.0, 0.35 * len(labels))))
+    bp = ax.boxplot(series, vert=False, labels=labels, patch_artist=True, showfliers=False)
+    for patch in bp["boxes"]:
+        patch.set_facecolor("#8AB6D6")
+        patch.set_alpha(0.8)
+    ax.set_xscale("log")
+    ax.set_xlabel("Seconds (log scale)")
+    ax.set_title("Runtime distribution across observed runs")
+    ax.grid(True, axis="x", linestyle=":", linewidth=0.4, alpha=0.6)
+    save_fig(fig, "fig_runtime_distribution")
+
+
+def build_results_overview(rows: list[dict]) -> None:
+    keep = [
+        "ASLS-AOM-compact-cv5 vs PLS-default",
+        "AOMRidge-Blender vs Ridge-default",
+        "FastAOM-sparse-mkr-supervised vs PLS-standard",
+        "FastAOM-sparse-mkr-supervised vs PLS-TabPFN-HPO",
+        "FastAOM-sparse-mkr-supervised vs ASLS-AOM-compact-cv5",
+    ]
+    by_label = {r["label"]: r for r in rows}
+    ratios = [by_label[k]["stats"]["median"] for k in keep]
+    wins = [by_label[k]["stats"]["wins"] / by_label[k]["stats"]["n"] for k in keep]
+    labels = [k.replace(" vs ", "\nvs ") for k in keep]
+    x = np.arange(len(keep))
+    fig, ax1 = plt.subplots(figsize=(7.0, 3.5))
+    ax1.bar(x - 0.18, ratios, width=0.36, color="#F28E2B", label="Median ratio")
+    ax1.axhline(1.0, color="#555555", linewidth=0.8, linestyle="--")
+    ax1.set_ylabel("Median RMSEP ratio")
+    ax1.set_xticks(x)
+    ax1.set_xticklabels(labels, rotation=25, ha="right", fontsize=7)
+    ax2 = ax1.twinx()
+    ax2.bar(x + 0.18, wins, width=0.36, color="#4C78A8", alpha=0.85, label="Win fraction")
+    ax2.set_ylabel("Win fraction")
+    ax2.set_ylim(0, 1.0)
+    ax1.set_title("Headline paired comparisons")
+    ax1.grid(True, axis="y", linestyle=":", linewidth=0.4, alpha=0.6)
+    save_fig(fig, "fig_results", png=False)
+
+
+def build_budget_figure() -> None:
+    labels = ["PLS-HPO", "Ridge-HPO", "CNN-1D", "CatBoost", "AOM compact", "FastAOM MKR"]
+    evals = [3000, 6000, 2700, 90, 45, 145]
+    colors = ["#4C78A8", "#59A14F", "#BAB0AC", "#E15759", "#F28E2B", "#B07AA1"]
+    fig, ax = plt.subplots(figsize=(6.4, 3.4))
+    ax.bar(labels, evals, color=colors)
+    ax.set_yscale("log")
+    ax.set_ylabel("Candidate fits or screened chains (log scale)")
+    ax.set_title("Search-budget scale")
+    ax.tick_params(axis="x", rotation=25)
+    ax.grid(True, axis="y", linestyle=":", linewidth=0.4, alpha=0.6)
+    save_fig(fig, "fig_budget", png=False)
+
+
+def build_operator_heatmap() -> None:
+    diag = pd.read_csv(REVIEW / "selector_diagnostics.csv", low_memory=False)
+    diag = diag[diag["variant"].isin(["AOM-compact-cv5-numpy", "ASLS-AOM-compact-cv5-numpy"])]
+    op_cols = [c for c in diag.columns if c.startswith("selected_op_")]
+    counts = defaultdict(lambda: defaultdict(int))
+    for _, row in diag.iterrows():
+        ds = row["dataset"]
+        for col in op_cols:
+            op = row.get(col)
+            if isinstance(op, str) and op:
+                counts[ds][op] += 1
+    ops = list(pd.read_csv(REVIEW / "operator_frequency.csv")["operator"])
+    manifest = pd.read_csv(REVIEW / "cohort_manifest.csv")
+    domain = dict(zip(manifest["dataset"], manifest["domain_group"]))
+    datasets = sorted(counts, key=lambda d: (str(domain.get(d, "")), d))
+    matrix = np.array([[counts[d].get(op, 0) for op in ops] for d in datasets], dtype=float)
+    fig, ax = plt.subplots(figsize=(8.2, max(5.5, 0.12 * len(datasets))))
+    im = ax.imshow(matrix, aspect="auto", cmap="viridis")
+    ax.set_xticks(np.arange(len(ops)))
+    ax.set_xticklabels(ops, rotation=45, ha="right", fontsize=7)
+    ax.set_yticks(np.arange(len(datasets)))
+    ax.set_yticklabels([f"{domain.get(d, 'other')}: {d}" for d in datasets], fontsize=4.8)
+    ax.set_title("Compact-bank operator selections by dataset")
+    cbar = fig.colorbar(im, ax=ax, fraction=0.025, pad=0.01)
+    cbar.set_label("Selection count across components/seeds")
+    save_fig(fig, "fig_operator_heatmap")
+
+
+def build_dataset_variant_heatmap(dfs: dict[str, pd.DataFrame]) -> None:
+    wide = pd.read_csv(FAST_WIDE, low_memory=False)
+    wide["dataset"] = dataset_id(wide["dataset"])
+    variants = [
+        "AOM-compact-cv5-numpy",
+        "ASLS-AOM-compact-cv5-numpy",
+        "FastAOM-sparse-mkr-supervised",
+        "FastAOM-sparse-mkr-compact",
+        "FastAOM-single-chain-compact",
+        "FastAOM-soft-chain-compact",
+        "FastAOM-hard-chain-compact",
+        "POP-nipals-adjoint-numpy",
+    ]
+    datasets = sorted(wide["dataset"].dropna().unique())
+    matrix = []
+    for ds in datasets:
+        row = wide[wide["dataset"] == ds].iloc[0]
+        ref = pd.to_numeric(pd.Series([row.get("PLS-standard-numpy")]), errors="coerce").iloc[0]
+        vals = []
+        for variant in variants:
+            val = pd.to_numeric(pd.Series([row.get(variant)]), errors="coerce").iloc[0]
+            vals.append(val / ref if np.isfinite(val) and np.isfinite(ref) and ref > 0 and ds not in EXCLUDED_RATIO_DATASETS else np.nan)
+        matrix.append(vals)
+    data = np.array(matrix, dtype=float)
+    masked = np.ma.masked_invalid(np.clip(data, 0.75, 1.35))
+    cmap = plt.get_cmap("coolwarm").copy()
+    cmap.set_bad("#eeeeee")
+    fig, ax = plt.subplots(figsize=(8.0, max(6.0, 0.12 * len(datasets))))
+    im = ax.imshow(masked, aspect="auto", cmap=cmap, vmin=0.75, vmax=1.35)
+    ax.set_xticks(np.arange(len(variants)))
+    ax.set_xticklabels(variants, rotation=45, ha="right", fontsize=7)
+    ax.set_yticks(np.arange(len(datasets)))
+    ax.set_yticklabels(datasets, fontsize=4.8)
+    ax.set_title("Per-dataset RMSEP ratios vs PLS-standard")
+    cbar = fig.colorbar(im, ax=ax, fraction=0.025, pad=0.01)
+    cbar.set_label("RMSEP ratio (clipped)")
+    save_fig(fig, "fig_dataset_variant_heatmap")
+
+
+def build_fastaom_variants_figure() -> None:
+    summary = pd.read_csv(FAST_SUMMARY)
+    rows = summary[summary["model"].astype(str).str.startswith("FastAOM")].copy()
+    rows = rows.sort_values("median_rel_rmse", ascending=False)
+    y = np.arange(len(rows))
+    fig, ax1 = plt.subplots(figsize=(7.4, max(4.0, 0.28 * len(rows))))
