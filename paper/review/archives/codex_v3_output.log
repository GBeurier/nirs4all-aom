+        "FastAOM-sparse-mkr-supervised vs PLS-TabPFN-HPO",
+        "FastAOM-sparse-mkr-supervised vs ASLS-AOM-compact-cv5",
+    ]
+    by_label = {r["label"]: r for r in rows}
+    lines = [
+        r"\begin{tabularx}{\linewidth}{p{0.31\linewidth}Xrr}",
+        r"\toprule",
+        r"Comparison & Evidence source & $N$ & Median RMSEP ratio / wins \\",
+        r"\midrule",
+    ]
+    for label in keep:
+        r = by_label[label]
+        s = r["stats"]
+        lines.append(
+            f"{latex_escape(label)} & {latex_escape(r['source'])} & {s['n']} & "
+            f"{fmt_float(s['median'])}; {s['wins']}/{s['n']} \\\\"
+        )
+    lines += [r"\bottomrule", r"\end{tabularx}", ""]
+    (TABLES / "table_main_results.tex").write_text("\n".join(lines))
