+  for FastAOM full-cohort evidence.
+  \item \code{bench/scenarios/runs/paper\_aom\_linear\_hpo\_full\_cartesian\_*}
+  for cartesian PLS/Ridge HPO and default-CV baselines.
+  \item \code{bench/AOM\_v0/Ridge/benchmark\_runs/all54\_headline/results.csv}
+  and \code{bench/AOM\_v0/Ridge/benchmark\_runs/paper\_aom\_aomridge\_seeds012/results.csv}
+  for AOM-Ridge regression.
+  \item \code{bench/AOM\_v0/benchmark\_runs/paper\_aom\_aompls\_da\_seeds012/results.csv}
+  and \code{bench/AOM\_v0/Ridge/benchmark\_runs/paper\_aom\_aomridge\_cls\_seeds012/results.csv}
+  for classification.
+  \item \code{paper\_aom/review/cohort\_manifest.csv},
+  \code{paper\_aom/review/operator\_frequency.csv},
+  \code{paper\_aom/review/failure\_mode\_table.csv} and
+  \code{paper\_aom/review/v3\_stats.md} for generated summaries.
+\end{itemize}
+
