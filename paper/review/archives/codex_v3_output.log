+def update_static_tables() -> None:
+    (TABLES / "table_benchmark_diversity.tex").write_text(
+        "\n".join(
+            [
+                r"\begin{tabularx}{\linewidth}{p{0.34\linewidth}X}",
+                r"\toprule",
+                r"Property & Summary used in this work \\",
+                r"\midrule",
+                r"Regression manifest & 61 included local regression rows; QUARTZ is retained for absolute-error diagnostics and excluded from pairwise ratios because its reference denominator is near zero. \\",
+                r"AOM-PLS paired cohort & 53 non-QUARTZ datasets with paired multi-seed AOM-PLS and PLS rows. \\",
+                r"FastAOM headline cohort & 50--52 datasets for the three performant FastAOM variants after filtering successful full-cohort rows. \\",
+                r"Linear cartesian-HPO cohort & 36 complete PLS-HPO datasets and 35 complete Ridge-HPO datasets with three successful seeds; the LUCAS\_SOC subset exceeded the compute budget and two FUSARIUM NaN-response rows failed estimator checks. \\",
+                r"Classification cohort & 16 AOM-PLS-DA datasets and 14 AOM-Ridge classification datasets with three seeds. \\",
+                r"Analytical domains & Leaf physiology, fruit quality, grain and seed traits, dairy, beverages, meat quality, petroleum, soil, manure, wood products, tablets and public calibration datasets. \\",
+                r"Sample and wavelength range & Calibration sets span 28--39{,}225 samples and 125--4{,}200 spectral variables in the local regression manifest. \\",
+                r"Validation rule & External test sets are never used for preprocessing, operator, component or regularization selection. \\",
+                r"\bottomrule",
+                r"\end{tabularx}",
+                "",
+            ]
+        )
+    )
+    (TABLES / "table_software.tex").write_text(
+        "\n".join(
+            [
+                r"\begin{tabularx}{\linewidth}{p{0.30\linewidth} X p{0.20\linewidth}}",
+                r"\toprule",
+                r"Component & Tests / evidence & Status \\",
+                r"\midrule",
+                r"\texttt{nirs4all} AOM-PLS reference & Unit tests for \nolinkurl{test_aom_pls}; production package path in the public repository. & production \\",
+                r"\texttt{nirs4all} AOM-lib wrapper & Wrapper unit test \nolinkurl{test_aom_pls_aomlib.py}. & integration validated \\",
+                r"\texttt{AOM\_lib} C++17 core & \nolinkurl{test_operators}, \nolinkurl{test_parity_kfold}, and C ABI smoke test. & parity verified \\",
+                r"\texttt{AOM\_lib} Python binding & Python parity test suite with 9/9 reference cases. & parity verified \\",
+                r"\texttt{AOM\_lib} R/MATLAB/Julia/JS bindings & Distributed parity-test harnesses for each binding. & code ready \\",
+                r"FastAOM experimental framework & 54 tests, full60 seed0 benchmark, and four documented review rounds. & validated by four Codex review rounds \\",
+                r"AOM-Ridge research code & Ridge test directory plus regression and classification paper benchmark runs. & research validated \\",
+                r"\bottomrule",
+                r"\end{tabularx}",
+                "",
