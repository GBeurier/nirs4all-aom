+                    "fig_results",
+                    "fig_budget",
+                    "fig_operator_heatmap",
+                    "fig_dataset_variant_heatmap",
+                    "fig_fastaom_variants",
+                ],
+            },
+            indent=2,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

