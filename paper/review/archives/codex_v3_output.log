+def save_fig(fig: plt.Figure, stem: str, png: bool = True) -> None:
+    FIGURES.mkdir(parents=True, exist_ok=True)
+    fig.savefig(FIGURES / f"{stem}.pdf", bbox_inches="tight")
+    if png:
+        fig.savefig(FIGURES / f"{stem}.png", dpi=300, bbox_inches="tight")
+    plt.close(fig)
+
