+            stat_row(
+                "AOM-compact-cv5 vs PLS-standard",
+                "AOM-compact-cv5-numpy",
+                "PLS-standard-numpy",
+                per_dataset(aompls, "AOM-compact-cv5-numpy"),
+                per_dataset(aompls, "PLS-standard-numpy"),
+                "AOM-PLS seeds012",
+            ),
+            stat_row(
+                "AOM-default-nipals-adjoint vs PLS-standard",
