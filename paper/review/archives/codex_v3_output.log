+    --aomridge bench/AOM_v0/Ridge/benchmark_runs/paper_aom_aomridge_seeds012/results.csv \
+    --out paper_aom/review/ --tables paper_aom/tables/
+
+python paper_aom/review/build_paper_figures.py
 
