+                per_dataset(ridge_hpo, "ridge-tabpfn-hpo-60trials"),
+                "AOM-Ridge top5 seeds012 / cartesian HPO seeds012",
+            ),
+            stat_row(
+                "FastAOM-sparse-mkr-supervised vs PLS-standard",
+                "FastAOM-sparse-mkr-supervised",
