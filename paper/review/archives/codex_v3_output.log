+    keep = [
+        "ASLS-AOM-compact-cv5 vs PLS-standard",
+        "AOM-compact-cv5 vs PLS-standard",
+        "AOM-default-nipals-adjoint vs PLS-standard",
+        "ASLS-AOM-compact-cv5 vs PLS-default",
+        "AOM-compact-cv5 vs PLS-default",
