+def write_table_main(rows: list[dict]) -> None:
+    keep = [
+        "ASLS-AOM-compact-cv5 vs PLS-default",
+        "AOM-compact-cv5 vs PLS-default",
+        "AOM-default-nipals-adjoint vs PLS-default",
+        "ASLS-AOM-compact-cv5 vs PLS-TabPFN-HPO",
