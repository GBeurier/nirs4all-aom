+            n_test2, p_test = _load_matrix_shape(paths.get("test_path", ""))
+            if np.isfinite(n_train2):
+                n_train = n_train2
+            if np.isfinite(n_test2):
+                n_test = n_test2
+            if np.isfinite(p_train):
+                p = p_train
+            elif np.isfinite(p_test):
