+        r"\multicolumn{8}{r}{Continued on next page} \\",
+        r"\midrule",
+        r"\endfoot",
+        r"\bottomrule",
+        r"\endlastfoot",
+    ]
+    for _, r in overview.iterrows():
+        long_lines.append(
