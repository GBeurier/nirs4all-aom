+        r"\end{tabular}",
+        "",
+    ]
+    (TABLES / "table_dataset_statistics.tex").write_text("\n".join(stats_lines))
+
+    overview = cohort.sort_values(["task", "domain", "dataset"], ascending=[True, True, True])
+    long_lines = [
+        r"\clearpage",
