+
+    overview = cohort.sort_values(["task", "domain", "dataset"], ascending=[True, True, True])
+    long_lines = [
+        r"\clearpage",
+        r"\begin{landscape}",
+        r"\begingroup",
+        r"\small",
+        r"\setlength{\tabcolsep}{3.0pt}",
+        r"\renewcommand{\arraystretch}{1.08}",
+        r"\setlength{\LTpre}{4pt}",
+        r"\setlength{\LTpost}{4pt}",
