+def _read_csv_auto(path: Path) -> pd.DataFrame | None:
+    if not path.exists():
+        return None
+    df = pd.read_csv(path)
+    if df.shape[1] == 1 and (";" in str(df.columns[0])):
+        df = pd.read_csv(path, sep=";")
+    return df
