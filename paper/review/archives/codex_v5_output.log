+            f"{latex_escape(r['split_type'])} & {latex_escape(r['domain'])} \\\\"
+        )
+    long_lines += [
+        r"\end{longtable}",
+        r"\endgroup",
+        r"\end{landscape}",
+        r"\clearpage",
+        "",
+    ]
+    (TABLES / "table_dataset_overview_supp.tex").write_text("\n".join(long_lines))
