+        r"\midrule",
+        r"\endfoot",
+        r"\bottomrule",
+        r"\endlastfoot",
+    ]
+    for _, r in overview.iterrows():
+        long_lines.append(
+            f"{latex_escape(r['dataset'])} & {latex_escape(r['task'])} & "
+            f"{fmt_int(float(r['n_samples']))} & {fmt_int(float(r['n_features']))} & "
