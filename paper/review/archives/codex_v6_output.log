def latex_escape(value: object) -> str:
    text = str(value)
    repl = {
        "\\": r"\textbackslash{}",
        "&": r"\&",
        "%": r"\%",
        "$": r"\$",
        "#": r"\#",
        "_": r"\_\allowbreak{}",
        "{": r"\{",
        "}": r"\}",
        "~": r"\textasciitilde{}",
        "^": r"\textasciicircum{}",
        "/": r"/\allowbreak{}",
        "-": r"-\allowbreak{}",
    }


def stat_row(label: str, candidate: str, reference: str, cand: pd.Series, ref: pd.Series, source: str) -> dict:
    s = paired_stats(cand, ref, lower_is_better=True)
    return {
        "label": label,
        "candidate": candidate,
        "reference": reference,
        "source": source,
        "stats": s,
        "p_holm": float("nan"),
    }


