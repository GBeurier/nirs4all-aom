    "predict_time_s",
    "total_time_s",
    "n_trials",
    "best_config_json",
    "started_at",
    "ended_at",
]

DEFAULT_TIMEOUT_S: int = 30 * 60


# ---------------------------------------------------------------------------
# Preprocessing search space (TabPFN paper)
# ---------------------------------------------------------------------------


def _norm_choices() -> list[tuple[str, BaseEstimator | None]]:
    return [
        ("none", None),
        ("snv", SNV()),
        ("msc", MSC()),
        ("emsc1", EMSC(degree=1)),
        ("emsc2", EMSC(degree=2)),
    ]


def _smooth_choices() -> list[tuple[str, BaseEstimator | None]]:
    return [
        ("none", None),
        ("sg_11_2_1", SG(window_length=11, polyorder=2, deriv=1)),
        ("sg_15_2_1", SG(window_length=15, polyorder=2, deriv=1)),
        ("sg_21_2_1", SG(window_length=21, polyorder=2, deriv=1)),
        ("sg_31_2_1", SG(window_length=31, polyorder=2, deriv=1)),
        ("sg_15_3_2", SG(window_length=15, polyorder=3, deriv=2)),
        ("sg_21_3_2", SG(window_length=21, polyorder=3, deriv=2)),
        ("sg_31_3_2", SG(window_length=31, polyorder=3, deriv=2)),
        ("gauss_0_1", Gaussian(order=0, sigma=1)),
        ("gauss_0_2", Gaussian(order=0, sigma=2)),
    ]


def _baseline_choices() -> list[tuple[str, BaseEstimator | None]]:
    return [("none", None), ("asls", ASLSBaseline()), ("detrend", Detrend())]


def _osc_choices() -> list[tuple[str, BaseEstimator | None]]:
    return [
        ("none", None),
        ("osc_1", OSC(n_components=1)),
        ("osc_2", OSC(n_components=2)),
        ("osc_3", OSC(n_components=3)),
    ]


def build_preproc_pipeline(
    norm_key: str,
    smooth_key: str,
    baseline_key: str,
    osc_key: str,
) -> Pipeline:
    """Build a fresh sklearn Pipeline for the chosen preprocessing keys."""
    steps: list[tuple[str, BaseEstimator]] = []
    lookup = {
        "norm": dict(_norm_choices()),
        "smooth": dict(_smooth_choices()),
        "baseline": dict(_baseline_choices()),
        "osc": dict(_osc_choices()),
    }
    for slot, key in [
        ("norm", norm_key),
        ("smooth", smooth_key),
        ("baseline", baseline_key),
        ("osc", osc_key),
    ]:
        op = lookup[slot][key]
        if op is not None:
            steps.append((slot, clone(op)))
    # TabPFN paper: centering only (with_mean=True, with_std=False)
    steps.append(("center", StandardScaler(with_mean=True, with_std=False)))
    return Pipeline(steps)


# ---------------------------------------------------------------------------
# Timeout handling
# ---------------------------------------------------------------------------


class _TimeoutError(Exception):
    pass


@contextmanager
def time_limit(seconds: int) -> Iterator[None]:
    """SIGALRM-based timeout. POSIX only — fine for Linux benchmarks."""

    def _handler(signum: int, frame: Any) -> None:  # noqa: ARG001
        raise _TimeoutError(f"Hit {seconds}s timeout")

    old = signal.signal(signal.SIGALRM, _handler)
    signal.alarm(seconds)
    try:
        yield
    finally:
        signal.alarm(0)
        signal.signal(signal.SIGALRM, old)


