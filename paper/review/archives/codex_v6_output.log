"""TabPFN-paper-style PLS/Ridge HPO baseline runner with detailed timing.

This runner backs the AOM paper's time-gain claim by recording explicit
fit/search time numbers for four variants on the frozen 60-dataset
regression cohort, faithfully replicating the TabPFN-paper protocol from
``bench/tabpfn_paper/run_reg_pls.py`` and ``full_run.py``:

    - ``pls-default-cv5``  : no preproc search, CV-5 over n_components only
    - ``pls-tabpfn-hpo``   : **full cartesian** over the TabPFN-paper preproc
                             space (5 norm × 10 smooth × 3 baseline × 4 osc
                             = 600 combos), with a per-combo Optuna TPE of 5
                             trials over n_components ∈ [1..25].  Total
                             trials per (dataset, seed) = 600 × 5 = 3,000.
                             (Reduced from the paper's per-combo n=25 to keep
                             multi-seed wall-time tractable while still
                             covering every preproc combination.)
    - ``ridge-default-cv5``: no preproc search, log-uniform alpha grid only
    - ``ridge-tabpfn-hpo`` : full cartesian (600 combos) × per-combo Optuna
                             10 trials over alpha + solver + fit_intercept.
                             Total trials per (dataset, seed) = 6,000.
                             (Reduced from the paper's per-combo n=60 for the
                             same wall-time reason.)

The cartesian iteration is parallelised via ``joblib.Parallel`` with
``n_jobs=DEFAULT_PARALLEL_JOBS`` (12 by default) so the wall-clock matches
what a chemometrics group would experience on a workstation.

Outputs ``results.csv`` in ``--workspace``, resumable on (dataset, variant, seed).

Usage:
    python bench/tabpfn_paper/run_linear_hpo_paper_aom.py \
        --cohort-path bench/AOM_v0/benchmarks/cohort_regression.csv \
        --workspace bench/scenarios/runs/paper_aom_linear_hpo \
        --seeds 0 1 2 \
        --variants pls-default-cv5,pls-tabpfn-hpo-25trials,ridge-default-cv5,ridge-tabpfn-hpo-60trials
"""

from __future__ import annotations

import argparse
import itertools
import json
import os
import signal
import sys
import time
import warnings
from collections.abc import Iterator
from contextlib import contextmanager
from dataclasses import dataclass, field
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

import numpy as np
import optuna
import pandas as pd
from joblib import Parallel, delayed
from optuna.samplers import TPESampler
from sklearn.base import BaseEstimator, clone
from sklearn.cross_decomposition import PLSRegression
from sklearn.linear_model import Ridge
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import KFold
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler

# Parallelism for the cartesian preprocessing iteration. We default to
# ``n_jobs=1`` (sequential) because joblib's ``loky`` backend overhead
# dominates per-trial cost on these small spectroscopy datasets. To exploit
# the 24-core host, launch multiple OS-level processes (one per
# ``--seeds`` × ``--variants`` combo) writing to separate workspaces, then
# concatenate the result CSVs.
DEFAULT_PARALLEL_JOBS: int = 1

from nirs4all.operators.transforms import (
    ASLSBaseline,
    Detrend,
    Gaussian,
)
from nirs4all.operators.transforms import (
    ExtendedMultiplicativeScatterCorrection as EMSC,
)
from nirs4all.operators.transforms import (
    MultiplicativeScatterCorrection as MSC,
)
from nirs4all.operators.transforms import (
    SavitzkyGolay as SG,
)
from nirs4all.operators.transforms import (
    StandardNormalVariate as SNV,
)
from nirs4all.operators.transforms.orthogonalization import OSC

warnings.filterwarnings("ignore")
optuna.logging.set_verbosity(optuna.logging.WARNING)

RESULT_COLUMNS: list[str] = [
    "dataset",
    "variant",
    "seed",
    "status",
    "error_message",
    "n_train",
    "n_test",
    "n_features",
    "rmsep",
    "mae",
    "r2",
    "score_value",
    "ref_pls_score",
    "score_ratio_vs_pls",
    "search_time_s",
