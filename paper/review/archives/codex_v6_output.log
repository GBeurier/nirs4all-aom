# ---------------------------------------------------------------------------
# Variant runners
# ---------------------------------------------------------------------------


@dataclass
class VariantOutcome:
    status: str
    error_message: str = ""
    rmsep: float = float("nan")
    mae: float = float("nan")
    r2: float = float("nan")
    search_time_s: float = 0.0
    refit_time_s: float = 0.0
    predict_time_s: float = 0.0
    n_trials: int = 0
    best_config: dict[str, Any] = field(default_factory=dict)


def _fit_and_score(
    pipeline: Pipeline,
    X_train: np.ndarray,
    y_train: np.ndarray,
    X_test: np.ndarray,
    y_test: np.ndarray,
) -> tuple[float, float, float, float, float]:
    """Fit pipeline, return (rmsep, mae, r2, refit_time_s, predict_time_s)."""
    t0 = time.perf_counter()
    pipeline.fit(X_train, y_train)
    refit_time = time.perf_counter() - t0
    t1 = time.perf_counter()
    y_pred = np.asarray(pipeline.predict(X_test)).ravel()
    predict_time = time.perf_counter() - t1
    rmse = float(np.sqrt(mean_squared_error(y_test, y_pred)))
    mae = float(mean_absolute_error(y_test, y_pred))
    r2 = float(r2_score(y_test, y_pred))
    return rmse, mae, r2, refit_time, predict_time


def _cv_score(
    estimator: BaseEstimator,
    X: np.ndarray,
    y: np.ndarray,
    n_splits: int,
    seed: int,
) -> float:
    """Return mean RMSE over KFold."""
    kf = KFold(n_splits=n_splits, shuffle=True, random_state=seed)
    rmses: list[float] = []
    for tr_idx, va_idx in kf.split(X):
        est = clone(estimator)
        est.fit(X[tr_idx], y[tr_idx])
        pred = np.asarray(est.predict(X[va_idx])).ravel()
        rmses.append(float(np.sqrt(mean_squared_error(y[va_idx], pred))))
    return float(np.mean(rmses))


def run_pls_default_cv5(split: DatasetSplit, seed: int) -> VariantOutcome:
    """Plain PLS with CV-5 over n_components ∈ [1..25] — no preproc search."""
    started = time.perf_counter()
    max_k = min(25, split.X_train.shape[1], split.X_train.shape[0] - 1)
    candidates = list(range(1, max_k + 1))
    best_k = 1
    best_score = float("inf")
    base_pipe = Pipeline(
        [
            ("center", StandardScaler(with_mean=True, with_std=False)),
            ("pls", PLSRegression(n_components=1, scale=False)),
        ]
    )
    for k in candidates:
        base_pipe.set_params(pls__n_components=k)
        score = _cv_score(base_pipe, split.X_train, split.y_train, n_splits=5, seed=seed)
        if score < best_score:
            best_score = score
            best_k = k
    search_time = time.perf_counter() - started
    final_pipe = Pipeline(
        [
            ("center", StandardScaler(with_mean=True, with_std=False)),
            ("pls", PLSRegression(n_components=best_k, scale=False)),
        ]
    )
    rmse, mae, r2, refit_time, predict_time = _fit_and_score(
        final_pipe, split.X_train, split.y_train, split.X_test, split.y_test
    )
    return VariantOutcome(
        status="ok",
        rmsep=rmse,
        mae=mae,
        r2=r2,
        search_time_s=search_time,
        refit_time_s=refit_time,
        predict_time_s=predict_time,
        n_trials=len(candidates),
        best_config={"n_components": best_k, "search_mean_score": best_score},
    )


def run_ridge_default_cv5(split: DatasetSplit, seed: int) -> VariantOutcome:
    """Plain Ridge with CV-5 over a log-uniform alpha grid (15 points)."""
    started = time.perf_counter()
    alphas = np.logspace(-5, 4, num=15)
    best_alpha = float(alphas[0])
    best_score = float("inf")
    base_pipe = Pipeline(
        [
            ("center", StandardScaler(with_mean=True, with_std=False)),
            ("ridge", Ridge(alpha=1.0, solver="auto", fit_intercept=True, tol=1e-4)),
        ]
    )
    for alpha in alphas:
        base_pipe.set_params(ridge__alpha=float(alpha))
        score = _cv_score(base_pipe, split.X_train, split.y_train, n_splits=5, seed=seed)
        if score < best_score:
            best_score = score
            best_alpha = float(alpha)
    search_time = time.perf_counter() - started
    final_pipe = Pipeline(
        [
            ("center", StandardScaler(with_mean=True, with_std=False)),
            ("ridge", Ridge(alpha=best_alpha, solver="auto", fit_intercept=True, tol=1e-4)),
        ]
    )
    rmse, mae, r2, refit_time, predict_time = _fit_and_score(
        final_pipe, split.X_train, split.y_train, split.X_test, split.y_test
    )
    return VariantOutcome(
        status="ok",
        rmsep=rmse,
        mae=mae,
        r2=r2,
        search_time_s=search_time,
        refit_time_s=refit_time,
        predict_time_s=predict_time,
        n_trials=len(alphas),
        best_config={"alpha": best_alpha, "search_mean_score": best_score},
    )


def _suggest_preproc(trial: optuna.Trial) -> dict[str, str]:
    return {
        "norm": trial.suggest_categorical("norm", [k for k, _ in _norm_choices()]),
        "smooth": trial.suggest_categorical("smooth", [k for k, _ in _smooth_choices()]),
        "baseline": trial.suggest_categorical("baseline", [k for k, _ in _baseline_choices()]),
        "osc": trial.suggest_categorical("osc", [k for k, _ in _osc_choices()]),
    }


def _build_model_pipeline(preproc: dict[str, str], model: BaseEstimator) -> Pipeline:
    pipe = build_preproc_pipeline(preproc["norm"], preproc["smooth"], preproc["baseline"], preproc["osc"])
    return Pipeline(pipe.steps + [("model", model)])


def _all_cartesian_preproc_keys() -> list[tuple[str, str, str, str]]:
    """Enumerate the full TabPFN-paper cartesian preprocessing space.

    5 norm × 10 smooth × 3 baseline × 4 osc = 600 combinations. This mirrors
    ``_cartesian_`` with ``count: -1`` in ``bench/tabpfn_paper/run_reg_pls.py``.
    """
    return list(
        itertools.product(
            [k for k, _ in _norm_choices()],
            [k for k, _ in _smooth_choices()],
            [k for k, _ in _baseline_choices()],
            [k for k, _ in _osc_choices()],
        )
    )


def _pls_study_for_combo(
    combo: tuple[str, str, str, str],
    X_train: np.ndarray,
    y_train: np.ndarray,
    max_k: int,
    n_trials: int,
    seed: int,
) -> tuple[tuple[str, str, str, str], float, dict[str, Any]]:
    """Run one Optuna TPE study (n_trials over n_components) for a fixed preproc combo.

    Returns ``(combo, best_cv_rmse, best_params_dict)``. Used as the parallel
    inner kernel of :func:`run_pls_tabpfn_hpo`.
    """
    norm, smooth, baseline, osc = combo
    preproc_keys = {"norm": norm, "smooth": smooth, "baseline": baseline, "osc": osc}

    def objective(trial: optuna.Trial) -> float:
        n_components = trial.suggest_int("n_components", 1, max_k)
        pipe = _build_model_pipeline(
            preproc_keys, PLSRegression(n_components=n_components, scale=False)
        )
        try:
            return _cv_score(pipe, X_train, y_train, n_splits=3, seed=seed)
        except Exception:  # noqa: BLE001
            return float("inf")

    sampler = TPESampler(seed=seed)
    study = optuna.create_study(direction="minimize", sampler=sampler)
    study.optimize(objective, n_trials=n_trials, show_progress_bar=False)
    return combo, float(study.best_value), dict(study.best_params)


def run_pls_tabpfn_hpo(
    split: DatasetSplit,
    seed: int,
    n_trials_per_combo: int = 5,
    n_jobs: int = DEFAULT_PARALLEL_JOBS,
) -> VariantOutcome:
    """Full TabPFN-paper PLS HPO: 600 cartesian preproc × per-combo Optuna TPE.

    For each of the 5×10×3×4 = 600 cartesian preprocessing combinations, an
    Optuna TPE study with ``n_trials_per_combo`` trials searches PLS
    ``n_components`` ∈ [1..min(25, p, n-1)]. Total trials per (dataset, seed)
    = 600 × ``n_trials_per_combo``. Mirrors the protocol of
    ``bench/tabpfn_paper/run_reg_pls.py`` (cartesian ``count=-1`` + 25-trial
    finetune). Cartesian iteration is parallelised via joblib.
    """
    max_k = min(25, split.X_train.shape[1], split.X_train.shape[0] - 1)
    combos = _all_cartesian_preproc_keys()

    t0 = time.perf_counter()
    studies = Parallel(n_jobs=n_jobs, backend="loky", verbose=0)(
        delayed(_pls_study_for_combo)(
            combo, split.X_train, split.y_train, max_k, n_trials_per_combo, seed
        )
        for combo in combos
    )
    search_time = time.perf_counter() - t0

    best_combo, best_score, best_params = min(studies, key=lambda r: r[1])
    norm, smooth, baseline, osc = best_combo
    best = {
        "norm": norm,
        "smooth": smooth,
        "baseline": baseline,
        "osc": osc,
        "n_components": int(best_params["n_components"]),
        "search_mean_score": float(best_score),
    }
    final_pipe = _build_model_pipeline(
        {"norm": norm, "smooth": smooth, "baseline": baseline, "osc": osc},
        PLSRegression(n_components=int(best_params["n_components"]), scale=False),
    )
    rmse, mae, r2, refit_time, predict_time = _fit_and_score(
        final_pipe, split.X_train, split.y_train, split.X_test, split.y_test
    )
    return VariantOutcome(
        status="ok",
        rmsep=rmse,
        mae=mae,
        r2=r2,
        search_time_s=search_time,
        refit_time_s=refit_time,
        predict_time_s=predict_time,
        n_trials=len(combos) * n_trials_per_combo,
        best_config=best,
    )


def _ridge_study_for_combo(
    combo: tuple[str, str, str, str],
    X_train: np.ndarray,
    y_train: np.ndarray,
    n_trials: int,
    seed: int,
) -> tuple[tuple[str, str, str, str], float, dict[str, Any]]:
    """Run one Optuna TPE study (n_trials over alpha+solver+fit_intercept) for a fixed preproc combo.

    Used as the parallel inner kernel of :func:`run_ridge_tabpfn_hpo`.
    """
    norm, smooth, baseline, osc = combo
    preproc_keys = {"norm": norm, "smooth": smooth, "baseline": baseline, "osc": osc}

    def objective(trial: optuna.Trial) -> float:
        alpha = trial.suggest_float("alpha", 1e-5, 1e4, log=True)
        solver = trial.suggest_categorical("solver", ["auto", "svd", "cholesky", "lsqr"])
        fit_intercept = trial.suggest_categorical("fit_intercept", [True, False])
        model = Ridge(alpha=alpha, solver=solver, fit_intercept=fit_intercept, tol=1e-4)
        pipe = _build_model_pipeline(preproc_keys, model)
        try:
            return _cv_score(pipe, X_train, y_train, n_splits=3, seed=seed)
        except Exception:  # noqa: BLE001
            return float("inf")

    sampler = TPESampler(seed=seed)
    study = optuna.create_study(direction="minimize", sampler=sampler)
    study.optimize(objective, n_trials=n_trials, show_progress_bar=False)
    return combo, float(study.best_value), dict(study.best_params)


def run_ridge_tabpfn_hpo(
    split: DatasetSplit,
    seed: int,
    n_trials_per_combo: int = 10,
    n_jobs: int = DEFAULT_PARALLEL_JOBS,
) -> VariantOutcome:
    """Full TabPFN-paper Ridge HPO: 600 cartesian preproc × per-combo 60-trial TPE.

    For each of the 600 cartesian preprocessing combinations, an Optuna TPE
    study with ``n_trials_per_combo`` trials searches
    ``{alpha (log-uniform 1e-5..1e4), solver, fit_intercept}``.  Total trials
    per (dataset, seed) = 600 × ``n_trials_per_combo``.  Mirrors the protocol
    of ``bench/tabpfn_paper/full_run.py`` (cartesian ``count=-1`` + 60-trial
    finetune).
    """
    combos = _all_cartesian_preproc_keys()

    t0 = time.perf_counter()
    studies = Parallel(n_jobs=n_jobs, backend="loky", verbose=0)(
        delayed(_ridge_study_for_combo)(
            combo, split.X_train, split.y_train, n_trials_per_combo, seed
        )
        for combo in combos
    )
    search_time = time.perf_counter() - t0

    best_combo, best_score, best_params = min(studies, key=lambda r: r[1])
    norm, smooth, baseline, osc = best_combo
    best = {
        "norm": norm,
        "smooth": smooth,
        "baseline": baseline,
        "osc": osc,
        "alpha": float(best_params["alpha"]),
        "solver": str(best_params["solver"]),
        "fit_intercept": bool(best_params["fit_intercept"]),
        "search_mean_score": float(best_score),
    }
    final_pipe = _build_model_pipeline(
        {"norm": norm, "smooth": smooth, "baseline": baseline, "osc": osc},
        Ridge(
            alpha=float(best_params["alpha"]),
            solver=str(best_params["solver"]),
            fit_intercept=bool(best_params["fit_intercept"]),
            tol=1e-4,
        ),
    )
    rmse, mae, r2, refit_time, predict_time = _fit_and_score(
        final_pipe, split.X_train, split.y_train, split.X_test, split.y_test
    )
    return VariantOutcome(
        status="ok",
        rmsep=rmse,
        mae=mae,
        r2=r2,
        search_time_s=search_time,
        refit_time_s=refit_time,
        predict_time_s=predict_time,
        n_trials=len(combos) * n_trials_per_combo,
        best_config=best,
    )


