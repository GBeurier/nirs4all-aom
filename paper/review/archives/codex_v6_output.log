# Dataset loading
# ---------------------------------------------------------------------------


@dataclass
class DatasetSplit:
    name: str
    X_train: np.ndarray
    y_train: np.ndarray
    X_test: np.ndarray
    y_test: np.ndarray
    ref_pls_score: float | None = None


def _read_matrix(path: Path) -> np.ndarray:
    df = pd.read_csv(path, sep=";")
    return df.values.astype(np.float64, copy=False)


def load_split(row: pd.Series, project_root: Path) -> DatasetSplit:
    """Load train/test arrays from the cohort row."""
    X_train = _read_matrix(project_root / row["train_path"])
    X_test = _read_matrix(project_root / row["test_path"])
    y_train = _read_matrix(project_root / row["ytrain_path"]).ravel()
    y_test = _read_matrix(project_root / row["ytest_path"]).ravel()
    ds_name = f"{row['database_name']}/{row['dataset']}"
    ref = row.get("ref_rmse_pls", np.nan)
    try:
        ref_val = float(ref) if pd.notna(ref) else None
    except (TypeError, ValueError):
        ref_val = None
    return DatasetSplit(
        name=ds_name,
        X_train=X_train,
        y_train=y_train,
        X_test=X_test,
        y_test=y_test,
        ref_pls_score=ref_val,

