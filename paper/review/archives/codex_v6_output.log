/bin/bash -lc "python - <<'PY'
import pandas as pd
from pathlib import Path
paths={
'default':'paper_aom/review/default_linear.csv',
'pls_hpo':'paper_aom/review/linear_hpo.csv',
'ridge_hpo':'paper_aom/review/ridge_hpo.csv',
'aompls':'paper_aom/review/aompls_results.csv',
'ridge_head':'paper_aom/review/aomridge_headline.csv',
}
for name,path in paths.items():
    p=Path(path)
    if not p.exists():
        print(name,'missing')
        continue
    df=pd.read_csv(p, low_memory=False)
    print('\\n',name,df.shape,df.columns[:12].tolist())
    for v in ['pls-default-cv5','pls-tabpfn-hpo-25trials','AOM-compact-cv5-numpy','ASLS-AOM-compact-cv5-numpy','ridge-default-cv5','ridge-tabpfn-hpo-60trials','AOMRidge-global-compact-none','AOMRidge-Blender-headline-spxy3']:
        sub=df[df.get('variant',pd.Series(dtype=str)).astype(str).str.lower()==v.lower()]
        if sub.empty: continue
        out=[v, 'N='+str(len(sub))]
        for c in ['n_trials','fit_time_s','total_time_s']:
            if c in sub:
                vals=pd.to_numeric(sub[c], errors='coerce').dropna()
                if len(vals): out.append(f'{c}.median={vals.median():.6g}')
        print(' | '.join(out))
