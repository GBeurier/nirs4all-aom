codex
The supplement already contains the exploration material, but its section order is too thin for the requested final shape. I’m adding generated cohort and family tables now, then I’ll reorganize the supplement around those sections.
exec
/bin/bash -lc "python - <<'PY'
from pathlib import Path
import math
import pandas as pd

OUT = Path('paper_aom/tables')

def esc(s):
    if pd.isna(s):
        return ''
    s = str(s)
    repl = {
        '\\\\': r'\\textbackslash{}',
        '&': r'\\&',
        '%': r'\\%',
        '"'$'"': r'\\"'$'"',
        '#': r'\\#',
        '_': r'\\_',
        '{': r'\\{',
        '}': r'\\}',
        '~': r'\\textasciitilde{}',
        '"'^'"': r'\\textasciicircum{}',
    }
    return ''.join(repl.get(ch, ch) for ch in s)

def fmt(x, nd=3):
    try:
        x = float(x)
    except Exception:
        return 'n/a'
    if not math.isfinite(x):
        return 'n/a'
    if abs(x) >= 100:
        return f'{x:.1f}'
    if abs(x) >= 10:
        return f'{x:.2f}'
    return f'{x:.{nd}f}'

# Cohort manifest longtable.
manifest = pd.read_csv('paper_aom/review/cohort_manifest.csv')
manifest = manifest.sort_values(['task','domain_group','dataset'])
lines = [
    r'\\begin{longtable}{L{0.34\\linewidth}L{0.14\\linewidth}L{0.18\\linewidth}rrrL{0.15\\linewidth}}',
    r'\\caption{Cohort manifest used for the AOM paper.  Status is the primary-analysis flag from the refreshed manifest; exclusion notes are kept where present.}\\\\',
    r'\\toprule',
    r'Dataset & Task & Domain & Train & Test & "'$p$ & Status / note '"\\\\',
    r'\\midrule',
    r'\\endfirsthead',
    r'\\toprule',
    r'Dataset & Task & Domain & Train & Test & "'$p$ & Status / note '"\\\\',
    r'\\midrule',
    r'\\endhead',
]
for _, r in manifest.iterrows():
    status = str(r.get('status_in_primary_analysis',''))
    note = r.get('exclusion_reason','')
    status_note = status if pd.isna(note) or str(note).strip() in ('', 'nan') else f'{status}; {note}'
    lines.append(
        f\"{esc(r['dataset'])} & {esc(r['task'])} & {esc(r['domain_group'])} & \"
        f\"{int(r['n_train']) if pd.notna(r['n_train']) else 'n/a'} & \"
        f\"{int(r['n_test']) if pd.notna(r['n_test']) else 'n/a'} & \"
        f\"{int(r['n_features']) if pd.notna(r['n_features']) else 'n/a'} & {esc(status_note)} \\\\\\\\\"
    )
lines += [r'\\bottomrule', r'\\end{longtable}', '']
(OUT / 'table_cohort_manifest.tex').write_text('\\n'.join(lines))

# AOM-PLS family summary.
aom = pd.read_csv('bench/scenarios/runs/paper_aom_aompls_seeds012/results.csv')
aom = aom[aom['status'].astype(str).str.lower().eq('ok')].copy()
aom['RMSEP'] = pd.to_numeric(aom['RMSEP'], errors='coerce')
aom['fit_time_s'] = pd.to_numeric(aom['fit_time_s'], errors='coerce')
