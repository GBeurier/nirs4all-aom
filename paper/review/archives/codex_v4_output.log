-  \qquad
-  \bm\beta = \left(\sum_{b=1}^{m}s_b^2\A_b\transpose\A_b\right)
-  \X_c\transpose(\K+\alpha\mathbf I_n)^{-1}\Y_c .
+  \K=\sum_b s_b^2\X_c\A_b^\transpose\A_b\X_c^\transpose,
 \end{equation}
+which gives an original-space coefficient matrix through the matching
+operator metric
+$\sum_b s_b^2\A_b^\transpose\A_b$.
 
