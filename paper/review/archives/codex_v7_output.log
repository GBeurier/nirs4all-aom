+                ok_rows = ds_rows[ok_status(ds_rows["_status"])]
+                ok_seeds = int(len(ok_rows["_seed"].dropna().unique())) if spec.require_seeds else int(not ok_rows.empty)
+                status = "ok" if (ok_seeds >= (spec.require_seeds or 1)) else "error"
