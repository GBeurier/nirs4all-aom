+        ("AOM-Ridge (best)", dfs["ridge_head"], "AOMRidge-Blender-headline-spxy3", FAMILY_COLORS["AOM-Ridge"], "--"),
+    ]
+    fig, ax = plt.subplots(figsize=FIGSIZE_WIDE)
