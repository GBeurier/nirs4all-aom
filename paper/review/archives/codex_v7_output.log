        "axes.labelsize": 9.0,
        "xtick.labelsize": 8.0,
        "ytick.labelsize": 8.0,
        "legend.fontsize": 8.0,
        # Embed fonts as TrueType in PDF/PS so journal compliance checkers are happy
        "pdf.fonttype": 42,
        "ps.fonttype": 42,
        # Axes
        "axes.edgecolor": COLOR_AXIS,
        "axes.linewidth": 0.7,
