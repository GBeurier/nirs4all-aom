+            bbox={"facecolor": "white", "edgecolor": COLOR_GRID, "linewidth": 0.4, "alpha": 0.86},
+        )
+        style_grid(ax, axis="both")
+    handles, labels = axes.flat[0].get_legend_handles_labels()
+    if handles:
