    for _, r in rows.iterrows():
        lines.append(
            f"{latex_escape(r['model'])} & {latex_escape(family(r['model']))} & {int(r['n_datasets'])} & "
            f"{float(r['median_rel_rmse']):.3f} & {float(r['median_fit_time']):.2f} & "
            f"{int(r['winner_count'])} \\\\"
