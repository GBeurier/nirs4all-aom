+        ("PLS-HPO", dfs["pls_hpo"], "pls-tabpfn-hpo-25trials", FAMILY_COLORS["PLS"], "--"),
+        ("AOM-PLS (simple)", dfs["aompls"], "AOM-compact-cv5-numpy", FAMILY_COLORS["AOM-PLS"], "-"),
