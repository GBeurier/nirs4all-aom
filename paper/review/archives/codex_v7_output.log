    rows: list[dict], output_path: Path | str
) -> Path:
    """Write ``table_paired_stats.tex`` with N / CI / wins / Holm p."""
    output_path = Path(output_path)
    lines = [
        r"\begin{tabularx}{\linewidth}{Xrrrrr}",
