+        vals = vals[np.isfinite(vals)]
+        if vals.size == 0:
+            continue
+        vals = np.sort(vals)
+        y = (vals.size - np.arange(vals.size)) / vals.size
+        ax.step(vals, y, where="post", color=color, linestyle=linestyle, linewidth=1.4, label=label)
