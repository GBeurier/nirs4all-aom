+            "pls-tabpfn-hpo-25trials",
+            "ASLS-AOM-compact-cv5 vs PLS-TabPFN-HPO",
+        ),
+        (
+            "AOM-Ridge best vs Ridge-default",
+            dfs["ridge_head"],
+            "AOMRidge-Blender-headline-spxy3",
+            dfs["default"],
