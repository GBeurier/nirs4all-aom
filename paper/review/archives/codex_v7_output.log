+        fig.subplots_adjust(bottom=0.13)
+    save_fig(fig, "fig_paired_rmsep_scatter")
+
+
+def build_r2_cdf(dfs: dict[str, pd.DataFrame]) -> None:
+    strict = _strict_dataset_list(dfs)
+    n = len(strict)
+    specs = [
